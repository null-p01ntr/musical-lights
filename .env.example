# Copy to .env and fill in. Everything here is optional -- anything left unset can be
# configured on the Settings page instead. HA_* values set here override the Settings page
# and lock those fields, so there is exactly one place each value comes from.

# Home Assistant base URL, as seen from inside the container.
#   HA on the same host (host networking):  http://host.docker.internal:8123
#   HA elsewhere on the LAN:                http://homeassistant.local:8123
HA_URL=http://host.docker.internal:8123

# Long-lived access token (HA profile -> Security -> Long-lived access tokens).
HA_TOKEN=

# The input_boolean the app turns on for the duration of a session. Create it in HA first
# (Settings -> Devices & services -> Helpers -> Toggle). Naming it "MusicalLights" gives
# this entity id.
HA_HELPER=input_boolean.musicallights

# Lights to start with, used on FIRST RUN ONLY (after that the Settings page owns the list).
# entity_id:band[:threshold]  -- band is bass | mid | treble; a threshold (0-100) makes the
# light on/off: on at >= threshold. Dimmable vs on/off is otherwise detected from HA.
ML_LIGHTS=
# ML_LIGHTS=light.tv_strip:bass,light.ceiling:mid,switch.lamp_plug:treble:80

# Host port for the HTTPS UI.
ML_PORT=8445

# Self-signed certificate, generated once into ./data/certs. Put the names/IPs you will open
# the page by into the SAN, e.g. DNS:myhost.lan,IP:192.168.1.20. Delete ./data/certs and
# restart to regenerate after changing these.
CERT_CN=musical-lights
CERT_SAN=DNS:localhost,IP:127.0.0.1

LOG_LEVEL=INFO
