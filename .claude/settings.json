{
  "permissions": {
    "allow": [
      "Bash(git pull:*)",
      "Bash(.venv/bin/python -m unittest:*)",
      "Bash(.venv/bin/python -m py_compile:*)",
      "Bash(docker compose * config -q)"
    ],
    "deny": [
      "Bash(gh:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.env.local)",
      "Read(./.env.prod)",
      "Read(./data/**)",
      "Edit(./.env)",
      "Edit(./data/**)",
      "Write(./.env)",
      "Write(./data/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" files" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\" bash" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-python.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests.sh", "timeout": 120 }]
      }
    ]
  }
}
